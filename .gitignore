# .NET build output accidentally regenerated by running dotnet test/build
# against fixtures under build/utils/dotnet/solution/testdata/ - note
# obj/project.assets.json itself is a required, tracked fixture, so this
# only ignores the transient obj/Debug/ output, not the whole obj/ dir.
build/utils/dotnet/solution/testdata/**/obj/Debug/
